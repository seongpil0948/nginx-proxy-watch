{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2016",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "alwaysStrict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "es2017",
      "DOM"
    ],
    "moduleResolution": "Node",
    "sourceMap": true,
    "typeRoots": [
      "node_modules/@types",
      "src/@types"
    ],
    "types": [
      "node",
      "dockerode"
    ],
    "baseUrl": "./",
    "paths": {
      "@interfaces/*": ["./src/@types/*"]
    },
    "outDir": "./dist/"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
