/var/log/nginx/*/*.log {
        su root root
        daily
        missingok
        rotate 52
        compress
        delaycompress
        notifempty
        create 640 nginx adm
        sharedscripts
        postrotate
                nginx -s reopen > /dev/null 2>&1 || true
        endscript
}

