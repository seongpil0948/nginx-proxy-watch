/var/log/nginx/*/*.log {
        su root root
        daily
        missingok
        rotate 52
        compress
        delaycompress
        notifempty
        create 640 nginx adm
        sharedscripts
        copytruncate
        postrotate
                kill -USR1 `cat /var/run/nginx.pid`
        endscript
}

