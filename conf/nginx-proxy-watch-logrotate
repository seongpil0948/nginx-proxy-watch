
/var/log/nginx-proxy-watch/*.log {
    su root root
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 644 root root
    sharedscripts
    copytruncate
    postrotate
        /etc/init.d/docker-event-watcher stop && /etc/init.d/docker-event-watcher start
    endscript
}