<% if(https) {%>
server {
    listen 80 ;
    server_name  <%= locationPath ? host : serverName %>;
    server_tokens off; # version view disable

    charset utf-8;

    access_log  /var/log/nginx/<%= serverName %>/access.log;
    error_log   /var/log/nginx/<%= serverName %>/error.log;

    location / {
        return 301 https://$host$request_uri;
    }
}
<% } %>
server {
    listen       <%= https ?  "443 ssl" : 80 %>;
    <% if (https) {%>
    http2 on;
    <% }%>
    server_name  <%= locationPath ? host : serverName %>;
    server_tokens off; # version view disable

    charset utf-8;

    access_log  /var/log/nginx/<%= serverName %>/access.log;
    error_log   /var/log/nginx/<%= serverName %>/error.log;

    <% if (https) {%>
    ssl_session_timeout 5m;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_certificate <%= sslCert %>;
    ssl_certificate_key <%= sslKey %>;
    add_header Strict-Transport-Security "max-age=31536000" always;
    <% }%>

    client_max_body_size 50M;
    client_body_timeout 12;
    client_header_timeout 12;
    keepalive_timeout 180;
    send_timeout 180;

    <% location && location.forEach(loc => { %>
    location ^~ /<%= loc.path %> {
        rewrite ^/<%= loc.path %>/(.*)$ /$1 break;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version  1.1;
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "upgrade";

        proxy_pass http://<%= loc.host %>;
    }
    <% }) %>

    <% if (locationPath) {%>
    include "/app/conf.d/location.conf/<%= host %>/*.conf";
    <% }%>

    <% if (groupYn !== 'Y') {%>
    location / {
        # AWS ALB Health Check
        if ($uri = '/status') {
            access_log off;
            return 200;
        }

        #root /web/html;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version  1.1;
        proxy_set_header       Upgrade $http_upgrade;
        proxy_set_header       Connection "upgrade";

        proxy_pass http://<%= serverName %>;
        charset  UTF-8;
        access_log  /var/log/nginx/<%= serverName %>/access-was.log otel_combined;
        error_log   /var/log/nginx/<%= serverName %>/error-was.log;
    }
    <% }%>

    location ~ /WEB-INF {
        deny  all;
    }

}